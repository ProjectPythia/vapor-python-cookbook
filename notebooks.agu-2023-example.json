69a85e-64fa-489e-a90a-3d26447f10f0","html_id":"1e69a85e-64fa-489e-a90a-3d26447f10f0","key":"rKK4JuFxJO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Interactive Sliders - Open visualizer_widget_example.ipynb","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XmU93bjJoG"}],"identifier":"interactive-sliders-open-visualizer-widget-example-ipynb","label":"Interactive Sliders - Open visualizer_widget_example.ipynb","html_id":"interactive-sliders-open-visualizer-widget-example-ipynb","implicit":true,"key":"hHsl54dK05"}],"identifier":"6d2318bf-05bf-4afa-b6a6-93876362c494","html_id":"6d2318bf-05bf-4afa-b6a6-93876362c494","key":"AvG6wKRgAt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"*** Back to VAPOR for DVR and Python Engine ***","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zNfLdJ6GoK"}],"identifier":"id-back-to-vapor-for-dvr-and-python-engine","label":"*** Back to VAPOR for DVR and Python Engine ***","html_id":"id-back-to-vapor-for-dvr-and-python-engine","implicit":true,"key":"rwNQoOQCqa"}],"identifier":"11452b16-f820-408f-a9a7-42208d6c57ea","html_id":"11452b16-f820-408f-a9a7-42208d6c57ea","key":"E9ZobR5DJw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Timeseries Animation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JaatXH6rmI"}],"identifier":"timeseries-animation","label":"Timeseries Animation","html_id":"timeseries-animation","implicit":true,"key":"U3TGq3kizH"}],"identifier":"f9d7950e-0fb1-47b2-baaf-91392498c9ec","html_id":"f9d7950e-0fb1-47b2-baaf-91392498c9ec","key":"ptG4R2O96P"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"%%time\nfrom vapor.animation import Animation\nses.Load( homeDir + \"/et_1.vs3\")\nanim = Animation(ses)\ntimesteps = ses.GetTimesteps()\nfor ts in range(0, timesteps):\n    ses.SetTimestep(ts)\n    anim.CaptureFrame()\nanim.ShowInteractive()","key":"PFX0FFrkML"},{"type":"outputs","id":"AZPLvG64XmRbr4g3LOY7O","children":[],"key":"KmOu4skU74"}],"identifier":"c70ab08b-69fe-4edb-b16f-4bff8d6021e5","html_id":"c70ab08b-69fe-4edb-b16f-4bff8d6021e5","key":"QBd8gbNiGg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Keyframing","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wEPnQcqmEg"}],"identifier":"keyframing","label":"Keyframing","html_id":"keyframing","implicit":true,"key":"igJXpbx1GR"}],"identifier":"20ecc23a-188d-409c-b1c0-f4138d4607a8","html_id":"20ecc23a-188d-409c-b1c0-f4138d4607a8","key":"HMcpdBheaI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Import necessary modules\n\nfrom vapor import session, camera","key":"zv3mpmM1SV"},{"type":"outputs","id":"rLbf9fMJCd6K5xgbM03n7","children":[],"key":"HNZdQXasE6"}],"identifier":"066fd9f1-8780-4f5e-8b90-3f6918d4616e","html_id":"066fd9f1-8780-4f5e-8b90-3f6918d4616e","key":"reyf5zzhd4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Acquire the camera settings from an initial session file\n\nses1 = session.Session()\n#ses1.Load(\"/Users/pearse/Examples/eastTroublesome/et_1.vs3\")\nses1.Load(homeDir + \"/et_1.vs3\")\n#ses1.Load(\"~/Examples/eastTroublesome/et_1.vs3\")\n\ncam1 = ses1.GetCamera()\ndir1 = cam1.GetDirection()\npos1 = cam1.GetPosition()\nup1 = cam1.GetUp()","key":"dHrKgeu21G"},{"type":"outputs","id":"sKQlsoJNcE2dQU6MrmwBS","children":[],"key":"SAFsUnvApY"}],"identifier":"fcdbc4af-870d-4fee-83bc-94a77c608126","html_id":"fcdbc4af-870d-4fee-83bc-94a77c608126","key":"DkO1ZxglcS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Acquire the camera settings from a secondary session file that we will transition into\n\nses2 = session.Session()\nses2.Load( homeDir + \"/et_2.vs3\")\ncam2 = ses2.GetCamera()\ndir2 = cam2.GetDirection()\npos2 = cam2.GetPosition()\nup2 = cam2.GetUp()","key":"O4hecN6DcU"},{"type":"outputs","id":"awfPmP6dUpq-qhTgDvBWB","children":[],"key":"bxGMJJdps2"}],"identifier":"14319fae-3f92-4216-a3e6-54cdb62eab51","html_id":"14319fae-3f92-4216-a3e6-54cdb62eab51","key":"GMVa90lx0Y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Difference between camera positions on each axis\ndPositionX  = (pos2[0] - pos1[0])\ndPositionY  = (pos2[1] - pos1[1])\ndPositionZ  = (pos2[2] - pos1[2])\n\n# Difference between camera direction vectors on each axis\ndDirectionX = (dir2[0] - dir1[0])\ndDirectionY = (dir2[1] - dir1[1])\ndDirectionZ = (dir2[2] - dir1[2])\n\n# Difference between camera up vectors on each axis\ndUpX        = (up2[0] - up1[0])\ndUpY        = (up2[1] - up1[1])\ndUpZ        = (up2[2] - up1[2])","key":"M4ORCn0vIC"},{"type":"outputs","id":"L4VB4OWx4cVrF4Tg2Cqo3","children":[],"key":"UOaWraspR5"}],"identifier":"5fc42064-a963-4651-8a62-b45da8934c53","html_id":"5fc42064-a963-4651-8a62-b45da8934c53","key":"zPVJEuQsz9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Perform a linear interoplation between the Camera's start position, direction, and up vector\n\nsteps=50\nfor i in range(0,steps):\n    position = [\n        pos1[0]+dPositionX*i/steps,\n        pos1[1]+dPositionY*i/steps,\n        pos1[2]+dPositionZ*i/steps\n    ]\n    cam1.SetPosition( position )\n\n    direction = [\n        dir1[0]+dDirectionX*i/steps,\n        dir1[1]+dDirectionY*i/steps,\n        dir1[2]+dDirectionZ*i/steps\n    ]\n    cam1.SetDirection( direction )\n\n    up = [\n        up1[0]+dUpX*i/steps,\n        up1[1]+dUpY*i/steps,\n        up1[2]+dUpZ*i/steps\n    ]\n    cam1.SetUp( up )\n    ses1.Render( homeDir + \"captures/\" + str(i) + \".png\")","key":"KPa5L91PjT"},{"type":"outputs","id":"XyvvHtdv96Dawpbw1GrOg","children":[],"key":"hw0hi7QnuJ"}],"identifier":"f0c7c710-307d-48a9-a91d-9dcaae8ca9b4","html_id":"f0c7c710-307d-48a9-a91d-9dcaae8ca9b4","key":"EHyOhB5aAe"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Camera Orbit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gupbJOQ48Z"}],"identifier":"camera-orbit","label":"Camera Orbit","html_id":"camera-orbit","implicit":true,"key":"uO6nyr4QJT"}],"identifier":"67500a31-57bd-44c1-b6f5-46c1ee3339eb","html_id":"67500a31-57bd-44c1-b6f5-46c1ee3339eb","key":"XNWSE2dUp3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Import necessary modules\n\nimport cv2, os\nfrom vapor import session, animation\nfrom numpy import cross, eye, dot, radians, asarray, array\nfrom scipy.linalg import expm, norm\nUseValueFromSessionFile = None","key":"OwJzw2KNsZ"},{"type":"outputs","id":"bEZRkYwvGo8uHgUBcrWyC","children":[],"key":"hrKn9GlOj9"}],"identifier":"09425475-73b3-4e68-9dae-e84b7f49f181","html_id":"09425475-73b3-4e68-9dae-e84b7f49f181","key":"xsCvxcswjG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Configure various parameters for rotating the camera around the scene\nsession_path = homeDir + \"/et_2.vs3\"\noutput = \"rotation.mp4\"\nvideo_framerate = 30\nvideo_resolution = (640, 480)\ndata_timestep_framerate = 0  # set to zero to disable\nduration = 4  # seconds\nrotate_speed = 45  # deg/s\nrotation_axis = [0,0,1]  # Z (up)\nrotation_center = UseValueFromSessionFile  # Can be replaced with [x,y,z] coordinates here\nsave_individual_frames = False","key":"OCJFX5kqUE"},{"type":"outputs","id":"P97pJvrq49Kh13aEOpWIM","children":[],"key":"xmjeRvDfSN"}],"identifier":"987f0235-e3f6-4058-bb02-c83baa26a5a8","html_id":"987f0235-e3f6-4058-bb02-c83baa26a5a8","key":"a1mOxrlhvb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Configure our session according to the parameters that were defined above\n\nsession_path, output = [os.path.expanduser(p) for p in (session_path, output)]\nn_frames = video_framerate * duration\n\nses = session.Session()\nses.Load(session_path)\nses.SetResolution(*video_resolution)\ncam = ses.GetCamera()\npos, dir, up, tgt = [asarray(x) for x in [cam.GetPosition(), cam.GetDirection(), cam.GetUp(), cam.GetTarget()]]\nif rotation_center:\n    tgt = asarray(rotation_center)","key":"rET5Cj9ae8"},{"type":"outputs","id":"aPtgJvoYHy4OSQi7v8iDV","children":[],"key":"AOZuQGGlQA"}],"identifier":"bb86efd1-bfec-4a39-91e0-8d636e9491ab","html_id":"bb86efd1-bfec-4a39-91e0-8d636e9491ab","key":"ZeyrbOh8wN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Define a function that returns a matrix exponential for rotating the camera \n\ndef rotation_matrix(axis, theta):\n    return expm(cross(eye(3), axis / norm(axis) * theta))","key":"bP9eJebrJH"},{"type":"outputs","id":"2Bq4hlIs8iYkdvRbtLevM","children":[],"key":"IKWOxPbOTG"}],"identifier":"17eee996-8dcd-469a-9359-61935ea74441","html_id":"17eee996-8dcd-469a-9359-61935ea74441","key":"V7fZEwp5tw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"anim = animation.Animation(ses)\nfor i in range(0, n_frames):\n    print(f\"Rendering... [{'#'*round(40*i/(n_frames-1))}{' '*round(40*(1-i/(n_frames-1)))}] {100*(i+1)/n_frames:.0f}%\", end=\"\\r\" if i < n_frames-1 else \"\\n\")\n\n    ses.SetTimestep(int(data_timestep_framerate * i / video_framerate))\n\n    M = rotation_matrix(rotation_axis, radians(rotate_speed) * i / video_framerate)\n    cam.SetPosition(dot(M, pos - tgt) + tgt)\n    cam.SetDirection(dot(M, dir))\n    cam.SetUp(dot(M, up))\n    anim.CaptureFrame()\n    if save_individual_frames:\n        ses.Render(f\"{output}_{i:04}.png\")\n\nanim.SaveMP4(output, video_framerate)","key":"ofW3RefNXJ"},{"type":"outputs","id":"3wvsLFQzDozMDU5GkVisq","children":[],"key":"nYPMeNYVCZ"}],"identifier":"f0cb3e4b-d2d3-4e27-ae0f-89ca25736a9e","html_id":"f0cb3e4b-d2d3-4e27-ae0f-89ca25736a9e","key":"sKamHCKqzn"}],"key":"wjq3Nq8ggK"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Custom Map Images with Cartopy","url":"/notebooks/custom-images-example","group":"Foundations of VAPOR Python"},"next":{"title":"Generic Workflow","url":"/notebooks/workflow-example","group":"Example workflows"}}},"domain":"http://localhost:3000"}