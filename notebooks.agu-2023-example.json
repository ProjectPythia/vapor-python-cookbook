69a85e-64fa-489e-a90a-3d26447f10f0","html_id":"1e69a85e-64fa-489e-a90a-3d26447f10f0","key":"z4hHHREP0R"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Interactive Sliders - Open visualizer_widget_example.ipynb","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"I7kniIDMyn"}],"identifier":"interactive-sliders-open-visualizer-widget-example-ipynb","label":"Interactive Sliders - Open visualizer_widget_example.ipynb","html_id":"interactive-sliders-open-visualizer-widget-example-ipynb","implicit":true,"key":"pi6CUJ1BZN"}],"identifier":"6d2318bf-05bf-4afa-b6a6-93876362c494","html_id":"6d2318bf-05bf-4afa-b6a6-93876362c494","key":"IHEWmJa7Tm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"*** Back to VAPOR for DVR and Python Engine ***","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i38XBijnn8"}],"identifier":"id-back-to-vapor-for-dvr-and-python-engine","label":"*** Back to VAPOR for DVR and Python Engine ***","html_id":"id-back-to-vapor-for-dvr-and-python-engine","implicit":true,"key":"tpVlJm2vNj"}],"identifier":"11452b16-f820-408f-a9a7-42208d6c57ea","html_id":"11452b16-f820-408f-a9a7-42208d6c57ea","key":"kQKKmemAWo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Timeseries Animation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VbNak5rCAN"}],"identifier":"timeseries-animation","label":"Timeseries Animation","html_id":"timeseries-animation","implicit":true,"key":"c6dXGLukvQ"}],"identifier":"f9d7950e-0fb1-47b2-baaf-91392498c9ec","html_id":"f9d7950e-0fb1-47b2-baaf-91392498c9ec","key":"q61dAHCmis"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"%%time\nfrom vapor.animation import Animation\nses.Load( homeDir + \"/et_1.vs3\")\nanim = Animation(ses)\ntimesteps = ses.GetTimesteps()\nfor ts in range(0, timesteps):\n    ses.SetTimestep(ts)\n    anim.CaptureFrame()\nanim.ShowInteractive()","key":"fOh4mZpRWm"},{"type":"outputs","id":"07aV2b5CYSHg9gKIJVsGb","children":[],"key":"mwLcmyok9P"}],"identifier":"c70ab08b-69fe-4edb-b16f-4bff8d6021e5","html_id":"c70ab08b-69fe-4edb-b16f-4bff8d6021e5","key":"RBsaQeYtK5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Keyframing","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lOk00U7Cm5"}],"identifier":"keyframing","label":"Keyframing","html_id":"keyframing","implicit":true,"key":"WKrNKfpVJe"}],"identifier":"20ecc23a-188d-409c-b1c0-f4138d4607a8","html_id":"20ecc23a-188d-409c-b1c0-f4138d4607a8","key":"mISMaWVQXs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Import necessary modules\n\nfrom vapor import session, camera","key":"uXBpF8IV6e"},{"type":"outputs","id":"LLG9u4KeW-igUWGrVuAkb","children":[],"key":"wi2h2LcxB6"}],"identifier":"066fd9f1-8780-4f5e-8b90-3f6918d4616e","html_id":"066fd9f1-8780-4f5e-8b90-3f6918d4616e","key":"QnIPPTx1wD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Acquire the camera settings from an initial session file\n\nses1 = session.Session()\n#ses1.Load(\"/Users/pearse/Examples/eastTroublesome/et_1.vs3\")\nses1.Load(homeDir + \"/et_1.vs3\")\n#ses1.Load(\"~/Examples/eastTroublesome/et_1.vs3\")\n\ncam1 = ses1.GetCamera()\ndir1 = cam1.GetDirection()\npos1 = cam1.GetPosition()\nup1 = cam1.GetUp()","key":"NkX3UFznv9"},{"type":"outputs","id":"SDeoJJq-B7KFrgs24M1xF","children":[],"key":"q7dVtc9H1o"}],"identifier":"fcdbc4af-870d-4fee-83bc-94a77c608126","html_id":"fcdbc4af-870d-4fee-83bc-94a77c608126","key":"zDHd302Sez"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Acquire the camera settings from a secondary session file that we will transition into\n\nses2 = session.Session()\nses2.Load( homeDir + \"/et_2.vs3\")\ncam2 = ses2.GetCamera()\ndir2 = cam2.GetDirection()\npos2 = cam2.GetPosition()\nup2 = cam2.GetUp()","key":"tl4aqPshjt"},{"type":"outputs","id":"XPlmomaXHP_mDwBIbzWDG","children":[],"key":"ZgrQQF4r2Z"}],"identifier":"14319fae-3f92-4216-a3e6-54cdb62eab51","html_id":"14319fae-3f92-4216-a3e6-54cdb62eab51","key":"doBZcSVuZc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Difference between camera positions on each axis\ndPositionX  = (pos2[0] - pos1[0])\ndPositionY  = (pos2[1] - pos1[1])\ndPositionZ  = (pos2[2] - pos1[2])\n\n# Difference between camera direction vectors on each axis\ndDirectionX = (dir2[0] - dir1[0])\ndDirectionY = (dir2[1] - dir1[1])\ndDirectionZ = (dir2[2] - dir1[2])\n\n# Difference between camera up vectors on each axis\ndUpX        = (up2[0] - up1[0])\ndUpY        = (up2[1] - up1[1])\ndUpZ        = (up2[2] - up1[2])","key":"Zhho6FxqAB"},{"type":"outputs","id":"JS5C6hpekSYgVsC7K02d6","children":[],"key":"oRcR7byInk"}],"identifier":"5fc42064-a963-4651-8a62-b45da8934c53","html_id":"5fc42064-a963-4651-8a62-b45da8934c53","key":"S8v3nl23CY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Perform a linear interoplation between the Camera's start position, direction, and up vector\n\nsteps=50\nfor i in range(0,steps):\n    position = [\n        pos1[0]+dPositionX*i/steps,\n        pos1[1]+dPositionY*i/steps,\n        pos1[2]+dPositionZ*i/steps\n    ]\n    cam1.SetPosition( position )\n\n    direction = [\n        dir1[0]+dDirectionX*i/steps,\n        dir1[1]+dDirectionY*i/steps,\n        dir1[2]+dDirectionZ*i/steps\n    ]\n    cam1.SetDirection( direction )\n\n    up = [\n        up1[0]+dUpX*i/steps,\n        up1[1]+dUpY*i/steps,\n        up1[2]+dUpZ*i/steps\n    ]\n    cam1.SetUp( up )\n    ses1.Render( homeDir + \"captures/\" + str(i) + \".png\")","key":"a5UZFls4oR"},{"type":"outputs","id":"SdVzlQyotoIBUJdmv5Aki","children":[],"key":"bwzxNDQjxd"}],"identifier":"f0c7c710-307d-48a9-a91d-9dcaae8ca9b4","html_id":"f0c7c710-307d-48a9-a91d-9dcaae8ca9b4","key":"foRWKhsdfW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Camera Orbit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tq3YoOxdos"}],"identifier":"camera-orbit","label":"Camera Orbit","html_id":"camera-orbit","implicit":true,"key":"XSIxJLJs47"}],"identifier":"67500a31-57bd-44c1-b6f5-46c1ee3339eb","html_id":"67500a31-57bd-44c1-b6f5-46c1ee3339eb","key":"H8ZRFrmAjp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Import necessary modules\n\nimport cv2, os\nfrom vapor import session, animation\nfrom numpy import cross, eye, dot, radians, asarray, array\nfrom scipy.linalg import expm, norm\nUseValueFromSessionFile = None","key":"ROOlSpLsD1"},{"type":"outputs","id":"Tk2tgxUyLjPQtoBN8cjjA","children":[],"key":"QdpLVwMLkz"}],"identifier":"09425475-73b3-4e68-9dae-e84b7f49f181","html_id":"09425475-73b3-4e68-9dae-e84b7f49f181","key":"TTA53VgosW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Configure various parameters for rotating the camera around the scene\nsession_path = homeDir + \"/et_2.vs3\"\noutput = \"rotation.mp4\"\nvideo_framerate = 30\nvideo_resolution = (640, 480)\ndata_timestep_framerate = 0  # set to zero to disable\nduration = 4  # seconds\nrotate_speed = 45  # deg/s\nrotation_axis = [0,0,1]  # Z (up)\nrotation_center = UseValueFromSessionFile  # Can be replaced with [x,y,z] coordinates here\nsave_individual_frames = False","key":"ENd8TpTWCk"},{"type":"outputs","id":"fQyHfouIQteRi5_UYDPBV","children":[],"key":"zvY5i9ePzE"}],"identifier":"987f0235-e3f6-4058-bb02-c83baa26a5a8","html_id":"987f0235-e3f6-4058-bb02-c83baa26a5a8","key":"ikcfUm1yGR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Configure our session according to the parameters that were defined above\n\nsession_path, output = [os.path.expanduser(p) for p in (session_path, output)]\nn_frames = video_framerate * duration\n\nses = session.Session()\nses.Load(session_path)\nses.SetResolution(*video_resolution)\ncam = ses.GetCamera()\npos, dir, up, tgt = [asarray(x) for x in [cam.GetPosition(), cam.GetDirection(), cam.GetUp(), cam.GetTarget()]]\nif rotation_center:\n    tgt = asarray(rotation_center)","key":"naln9pGs66"},{"type":"outputs","id":"F0LR5ytDQy4Z-vGc5MNTd","children":[],"key":"aqCSVorAdM"}],"identifier":"bb86efd1-bfec-4a39-91e0-8d636e9491ab","html_id":"bb86efd1-bfec-4a39-91e0-8d636e9491ab","key":"cdsBPfNSQo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Define a function that returns a matrix exponential for rotating the camera \n\ndef rotation_matrix(axis, theta):\n    return expm(cross(eye(3), axis / norm(axis) * theta))","key":"g1tXuY0J4e"},{"type":"outputs","id":"3XJh4nF1ha8rvA7Wys230","children":[],"key":"BCG8SUVUPC"}],"identifier":"17eee996-8dcd-469a-9359-61935ea74441","html_id":"17eee996-8dcd-469a-9359-61935ea74441","key":"CmK6b4lqyH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"anim = animation.Animation(ses)\nfor i in range(0, n_frames):\n    print(f\"Rendering... [{'#'*round(40*i/(n_frames-1))}{' '*round(40*(1-i/(n_frames-1)))}] {100*(i+1)/n_frames:.0f}%\", end=\"\\r\" if i < n_frames-1 else \"\\n\")\n\n    ses.SetTimestep(int(data_timestep_framerate * i / video_framerate))\n\n    M = rotation_matrix(rotation_axis, radians(rotate_speed) * i / video_framerate)\n    cam.SetPosition(dot(M, pos - tgt) + tgt)\n    cam.SetDirection(dot(M, dir))\n    cam.SetUp(dot(M, up))\n    anim.CaptureFrame()\n    if save_individual_frames:\n        ses.Render(f\"{output}_{i:04}.png\")\n\nanim.SaveMP4(output, video_framerate)","key":"FvwvNpJgHt"},{"type":"outputs","id":"D_DErPzya5jcClMlA5rBh","children":[],"key":"zeh0nmzJ4D"}],"identifier":"f0cb3e4b-d2d3-4e27-ae0f-89ca25736a9e","html_id":"f0cb3e4b-d2d3-4e27-ae0f-89ca25736a9e","key":"xxQsfBn2Fj"}],"key":"dtZ6r3YsXB"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Custom Map Images with Cartopy","url":"/notebooks/custom-images-example","group":"Foundations of VAPOR Python"},"next":{"title":"Generic Workflow","url":"/notebooks/workflow-example","group":"Example workflows"}}},"domain":"http://localhost:3000"}